{
  "name": "@frontend-consistency/eslint-plugin",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@frontend-consistency/core": "workspace:*",
    "@typescript-eslint/parser": "8.72.1"
  },
  "devDependencies": {
    "eslint": "10.14.0"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "description": "ESLint rules that enforce a frontend-consistency design contract."
}
